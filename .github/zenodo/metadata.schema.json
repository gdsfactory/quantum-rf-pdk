{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Updater configuration, using Zenodo's InvenioRDM field shapes: https://github.com/inveniosoftware/invenio-rdm-records/blob/master/invenio_rdm_records/records/jsonschemas/records/record-v6.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept_id", "anchor_record_id", "repository", "affiliations", "contact_orcid", "contributors", "languages", "additional_titles", "additional_descriptions", "subjects", "related_identifiers", "custom_fields"],
  "properties": {
    "$schema": {"type": "string"},
    "concept_id": {"type": "string", "pattern": "^[0-9]+$"},
    "anchor_record_id": {"type": "string", "pattern": "^[0-9]+$"},
    "repository": {"type": "string", "pattern": "^https:[/][/]github\\.com/[^/]+/[^/]+$"},
    "affiliations": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/orcid"},
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/affiliation"}}
    },
    "contact_orcid": {"$ref": "#/$defs/orcid"},
    "contributors": {"type": "array", "items": {"$ref": "#/$defs/contributor"}},
    "languages": {"type": "array", "items": {"$ref": "#/$defs/vocabulary"}},
    "additional_titles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "lang", "title"],
        "properties": {
          "type": {"$ref": "#/$defs/vocabulary"},
          "lang": {"$ref": "#/$defs/vocabulary"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "additional_descriptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "lang", "description"],
        "properties": {
          "type": {"$ref": "#/$defs/vocabulary"},
          "lang": {"$ref": "#/$defs/vocabulary"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "subjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "related_identifiers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identifier", "scheme", "relation_type"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "scheme": {"type": "string", "minLength": 1},
          "relation_type": {"$ref": "#/$defs/vocabulary"}
        }
      }
    },
    "custom_fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "code:programmingLanguage": {"type": "array", "items": {"$ref": "#/$defs/vocabulary"}},
        "code:codeRepository": {"type": "string", "pattern": "^https://"}
      }
    }
  },
  "$defs": {
    "orcid": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"},
    "vocabulary": {
      "type": "object", "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}}
    },
    "affiliation": {
      "type": "object", "additionalProperties": false,
      "anyOf": [{"required": ["id"]}, {"required": ["name"]}],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "contributor": {
      "type": "object", "additionalProperties": false,
      "required": ["person_or_org", "role"],
      "properties": {
        "person_or_org": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "given_name", "family_name"],
          "properties": {
            "type": {"const": "personal"},
            "given_name": {"type": "string", "minLength": 1},
            "family_name": {"type": "string", "minLength": 1},
            "identifiers": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["scheme", "identifier"],
                "properties": {"scheme": {"const": "orcid"}, "identifier": {"$ref": "#/$defs/orcid"}}
              }
            }
          }
        },
        "role": {"$ref": "#/$defs/vocabulary"},
        "affiliations": {"type": "array", "items": {"$ref": "#/$defs/affiliation"}}
      }
    }
  }
}
