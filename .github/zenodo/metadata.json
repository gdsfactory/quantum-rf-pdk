  "additional_descriptions": [
    {
      "type": {"id": "abstract"},
      "lang": {"id": "fin"},
      "description": "QPDK on avoimen lähdekoodin prosessisuunnittelupaketti suprajohtaville kvantti- ja mikroaaltopiireille. Se perustuu gdsfactoryyn ja sisältää parametrisia kvanttipiirikomponentteja, kuten kubitteja, Josephson-liitoksia, resonaattoreita ja kytkimiä. Pakettiin kuuluu myös piirimallinnusta, sähkömagneettisen simuloinnin aineistoja ja esimerkkejä suunnittelusta ja simuloinnista."
    }
  ],
