{% extends "_job.sh.j2" %}
{#- A Ray cluster inside one allocation: a head on the first node, workers on
    the rest, and the driver on the head once the cluster answers. -#}
{%- block resources %}
#SBATCH --nodes={{ nodes }}
#SBATCH --exclusive
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task={{ cores_per_node }}
#SBATCH --mem={{ mem_per_node }}
{%- endblock %}
{%- block env %}
# Left to itself every solver invocation opens a full node's worth of BLAS
# threads, which thrashes the node once several trials share it.
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 \
       OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export RAY_ADDRESS="auto"
{%- endblock %}
{%- block body %}
# --- Ray cluster ----------------------------------------------------------
ray_steps=()
cleanup() {
  if [[ -n "${ray_steps[*]}" ]]; then
    kill "${ray_steps[@]}" 2>/dev/null || true
    wait "${ray_steps[@]}" 2>/dev/null || true
  fi
}
trap cleanup EXIT
mapfile -t nodes < <(scontrol show hostnames "$SLURM_JOB_NODELIST")
head="${nodes[0]}"
others=$(printf '%s\n' "${nodes[@]:1}" | paste -sd, -)
echo "Ray head $head over {{ nodes_count }} node(s)"

srun -N 1 -n 1 --nodelist="$head" \
  ray start --head --node-ip-address="$head" --port={{ ray_port }} --num-cpus="$SLURM_CPUS_PER_TASK" --block &
ray_steps+=("$!")

# The workers need the head's address to join it, and the head's GCS is not
# accepting connections the instant srun returns.
export RAY_ADDRESS="$head:{{ ray_port }}"
for _ in $(seq 1 60); do
  if ! kill -0 "${ray_steps[0]}" 2>/dev/null; then
    wait "${ray_steps[0]}" || true
    echo "Ray head failed to start" >&2
    exit 1
  fi
  ray status > /dev/null 2>&1 && break
  sleep 5
done
ray status
{% if nodes_count > 1 %}
srun -N {{ nodes_count - 1 }} -n {{ nodes_count - 1 }} --nodelist="$others" \
  bash -c {{ shellquote("set -euo pipefail\n" ~ setup ~ '\nexec ray start --address="$RAY_ADDRESS" --num-cpus="$SLURM_CPUS_PER_TASK" --block') }} &
ray_steps+=("$!")
{% endif %}
python - <<'PY'
import os
import time

import ray

ray.init(address=os.environ["RAY_ADDRESS"])
for _ in range(60):
    if sum(node["Alive"] for node in ray.nodes()) >= {{ nodes_count }}:
        break
    time.sleep(5)
else:
    raise RuntimeError("Ray workers did not join the allocation")
ray.shutdown()
PY
# --- driver ---------------------------------------------------------------
# A failing driver must still tear the cluster down, so the status is captured
# rather than left to ``set -e``.
set +e
{{ command }}
status=$?
set -e

exit "$status"
{%- endblock %}
